# The brochure loads nothing from anyone else, and the policy says so:
# no inline script or style, no third-party origin, no framing.
/*
  Content-Security-Policy: default-src 'none'; style-src 'self'; script-src 'self'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin

/fonts/*
  Cache-Control: public, max-age=2592000

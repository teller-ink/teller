// teller.ink — the brochure (docs/CORE-NEXT.md §16).
//
// A static site and nothing else: no `main`, no bindings, no teller code.
// "teller.ink may carry bytes; it never runs the game."
//
// This is its OWN worker (`teller-ink`), deliberately not the name the
// pre-fold hosted app deployed under. Deploying it moves the custom
// domain here and leaves that old worker, with its database and its
// campaign storage, untouched and unrouted — retiring those is a separate
// decision, and not one a brochure deploy should make by accident.
//
//   preview   wrangler dev --config site/wrangler.jsonc
//   deploy    wrangler deploy --config site/wrangler.jsonc
{
  "name": "teller-ink",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "teller.ink", "custom_domain": true }]
}
